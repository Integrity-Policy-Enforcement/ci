"""Run the cases that need the initramfs, and write down how they came out.

boot_verified is true only while the initramfs is the running root, so these
cases cannot run once the payload is up.  They are the same Case objects the
payload runs, driven by the same runner; only the reporting differs, because
there is no TAP stream yet.
"""

import json

import layout
import mounts
import runner
from cases.boot import INITRAMFS_CASES


def main():
    mounts.tmpfs(layout.initrd.BOOT_TMPFS_DIRECTORY, layout.initrd.ROOT / layout.TEST_MODULE_FILE)

    outcomes = {case.id: runner.test(case) for case in INITRAMFS_CASES}

    mounts.umount(layout.initrd.BOOT_TMPFS_DIRECTORY)
    layout.initrd.BOOT_VERIFIED_RECORD.write_text(json.dumps(outcomes) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
