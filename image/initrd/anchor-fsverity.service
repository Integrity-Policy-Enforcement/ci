[Unit]
Description=Load the fs-verity certificate and seal the keyring
DefaultDependencies=no
Before=initrd-root-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=file:/usr/lib/ipe/fsverity-cert.der
ExecStart=/usr/bin/keyctl padd asymmetric "" %%:.fs-verity
# With no restriction scheme, restrict_keyring seals .fs-verity against later links.
ExecStart=/usr/bin/keyctl restrict_keyring %%:.fs-verity
