[Unit]
Description=Run IPE tests against the booted kernel
RequiresMountsFor=/run/ipe-tests
# The run records the policies it starts from, so the narrowing has to
# have happened by then or the run would take that policy back out.
Requires=ipe-root-policy.service
After=ipe-root-policy.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /run/ipe-tests/start-tests
ExecStopPost=/usr/bin/systemctl --force poweroff
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
