policy_name=ipe_test_dmverity_shebang_roothash_sha3-256 policy_version=0.0.1
DEFAULT action=ALLOW
DEFAULT op=EXECUTE action=DENY
# /bin/sh, its ELF loader and shared libraries are on the signed root.
op=EXECUTE dmverity_signature=TRUE action=ALLOW
# The script is on an unsigned mapping and cannot use that rule.
op=EXECUTE dmverity_roothash=@DMVERITY_ROOTHASH_SHA3-256@ action=ALLOW
